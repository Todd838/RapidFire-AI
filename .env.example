# Anthropic (Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Market data (optional — yfinance is the free default)
POLYGON_API_KEY=

# Alpaca broker (paper by default)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Live trading gate — must stay false unless all readiness gates pass
# Enabling also requires go-readiness pass + typed UI confirmation.
LIVE_TRADING_ENABLED=false

# AutoTrader: dry-run logs would_trade decisions without placing orders
AUTO_TRADER_DRY_RUN=true

# Database
DATABASE_URL=sqlite:///./rapidfire.db
